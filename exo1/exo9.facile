i := 1;
while i <= 3 do
    j := 1;
    while j <= 3 do
        print i * 10 + j;
        
        if i = 2 then
          if j = 2 then
            break;
          endif;
        endif;
        
        j := j + 1;
    
    if i = 2 then
      continue;
    endif;
    
    print i * 100;
    i := i + 1;
  endwhile;
endwhile;
